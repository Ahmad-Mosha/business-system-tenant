{
  "name": "prime-market",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @prime/api",
    "dev:web": "npm run dev -w @prime/web",
    "db:up": "docker compose up -d",
    "test": "npm run test -w @prime/api",
    "typecheck": "npm run typecheck -w @prime/api && npm run typecheck -w @prime/web",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}