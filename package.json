{
  "name": "prime-market",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @prime/api dev",
    "dev:web": "pnpm --filter @prime/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @prime/api migrate",
    "generate": "pnpm --filter @prime/api generate",
    "seed": "pnpm --filter @prime/api seed",
    "seed:catalogue": "pnpm --filter @prime/api seed:catalogue"
  },
  "packageManager": "pnpm@10.6.3"
}
