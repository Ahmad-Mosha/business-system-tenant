# Copy to .env and fill in. Never commit .env.

NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://commerce:commerce@localhost:5433/commerce_ops
# Used by integration/e2e tests. Must be a DIFFERENT database - it gets truncated.
TEST_DATABASE_URL=postgres://commerce:commerce@localhost:5433/commerce_ops_test

# --- API ---
API_PORT=4000
# Comma-separated list of allowed browser origins.
WEB_ORIGIN=http://localhost:3000
# Set true only when serving over HTTPS (forces the Secure cookie flag).
COOKIE_SECURE=false

# --- Seed (development bootstrap only) ---
# The seed script creates the first admin. Choose a real password; it is hashed immediately.
SEED_ORG_NAME=PRIME
SEED_ORG_SLUG=prime
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Web ---
# Server-side base URL the Next.js app uses to reach the API.
API_BASE_URL=http://localhost:4000
