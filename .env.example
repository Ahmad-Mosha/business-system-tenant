# Copy to .env and fill in. Never commit .env — it holds real credentials.

# Postgres from docker-compose (port 5434; the previous build is on 5433)
DATABASE_URL=postgres://prime:prime@localhost:5434/primemarket

API_PORT=3001

# Signs API tokens. Any long random string: openssl rand -hex 32
JWT_SECRET=

# Bosta — courier API
BOSTA_KEY=

# Easy Orders — own website
EASY_ORDER_KEY=
EASYORDERS_WEBHOOK_SECRET=
EASYORDERS_STORE_ID=
