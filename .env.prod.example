# Copy to .env next to docker-compose.prod.yml, fill in real values, and
# never commit the filled-in copy. Compose reads this file automatically.

# The domain's A record must point at this instance's public IP before
# `docker compose up` — Caddy requests the certificate on first boot and
# fails the ACME challenge otherwise.
DOMAIN=prime.example.com

POSTGRES_USER=prime
POSTGRES_PASSWORD=
POSTGRES_DB=prime_market

# openssl rand -hex 32
JWT_SECRET=

# Real passwords for the two named accounts — never leave these unset on a
# publicly reachable box. See auth.service.ts.
ADMIN_SEED_PASSWORD=
MODERATOR_SEED_PASSWORD=

# Same values as the working .env at the repo root.
EASY_ORDER_KEY=
BOSTA_KEY=
EASYORDERS_WEBHOOK_SECRET=
EASYORDERS_STORE_ID=
